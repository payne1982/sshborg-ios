    "security_reminder_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere eine App-Sperre und Hardware-Verschlüsselung in den Einstellungen, um deine Zugangsdaten zu schützen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable an app lock and hardware encryption in Settings to keep your credentials safe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa un bloqueo de la app y el cifrado por hardware en Ajustes para mantener seguras tus credenciales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez un verrouillage de l'app et le chiffrement matériel dans les Paramètres pour protéger vos identifiants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita un blocco dell'app e la cifratura hardware nelle Impostazioni per tenere al sicuro le tue credenziali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報を安全に保つため、設定でアプリのロックとハードウェア暗号化を有効にしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative um bloqueio da app e a encriptação por hardware nas Definições para manter as suas credenciais seguras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите блокировку приложения и аппаратное шифрование в настройках, чтобы защитить свои данные."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть блокування застосунку та апаратне шифрування в Налаштуваннях для захисту ваших облікових даних."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中启用应用锁和硬件加密，以保护您的凭据安全。"
          }
        }
      }
    },
