    "group_delete_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" löschen? Die Hosts bleiben erhalten, ohne Gruppe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete \"%1$@\"? Its hosts will be kept, without a group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar \"%1$@\"? Los hosts se mantendrán, sin grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer \"%1$@\" ? Les hôtes seront conservés, sans groupe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare \"%1$@\"? Gli host verranno mantenuti, senza gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" を削除しますか？ホストはグループなしで保持されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar \"%1$@\"? Os hosts serão mantidos, sem grupo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить «%1$@»? Хосты этой группы сохранятся, но останутся без группы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити \"%1$@\"? Хости буде збережено, без групи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 \"%1$@\"？主机将被保留，不属于任何分组。"
          }
        }
      }
    },
