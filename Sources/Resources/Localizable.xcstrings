    "ios_host_colour_footer": {
      "comment": "iOS only — no Android counterpart. Translated for this app rather than imported, so unlike the rest it has not been through the Android app's review. Worth checking with a native speaker before release.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne eigene Farbe übernimmt ein Host die Farbe seiner Gruppe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a colour of its own, a host takes its group's."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin un color propio, un host adopta el de su grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans couleur propre, un hôte reprend celle de son groupe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza un colore proprio, un host assume quello del suo gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自の色を設定しない場合、ホストはグループの色を使用します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem uma cor própria, um host assume a do seu grupo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без собственного цвета хост наследует цвет своей группы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
