    "settings_allow_screenshots_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots und Bildschirmaufnahmen erlauben. Deaktiviert lassen, um sensible Inhalte zu schützen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permit screenshots and screen recording. Leave disabled to protect sensitive content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir capturas de pantalla y grabación de pantalla. Déjalo desactivado para proteger el contenido sensible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser les captures d'écran et l'enregistrement. Laisser désactivé pour protéger les contenus sensibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permetti screenshot e registrazione dello schermo. Lascia disattivato per proteggere i contenuti sensibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットと画面録画を許可します。機密コンテンツを保護するため、無効のままにすることを推奨します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir capturas de ecrã e gravação de ecrã. Manter desativado para proteger conteúdo sensível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить скриншоты и запись экрана. Оставьте выключенным для защиты конфиденциальных данных."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити знімки екрана та запис екрана. Залиште вимкненим для захисту конфіденційного вмісту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许截图和录屏。建议保持禁用以保护敏感内容。"
          }
        }
      }
    },
