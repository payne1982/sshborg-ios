    "host_port_forwarding_supporting": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Regel pro Zeile: [lokalPort:remoteHost:remotePort] oder [bind:lokalPort:remoteHost:remotePort]. Optionales -L-Präfix."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One rule per line: [localPort:remoteHost:remotePort] or [bindAddr:localPort:remoteHost:remotePort]. Optional -L prefix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla por línea: [puertoLocal:hostRemoto:puertoRemoto] o [bind:puertoLocal:hostRemoto:puertoRemoto]. Prefijo -L opcional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle par ligne : [portLocal:hôteDistant:portDistant] ou [bind:portLocal:hôteDistant:portDistant]. Préfixe -L facultatif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regola per riga: [portaLocale:hostRemoto:portaRemota] oppure [bind:portaLocale:hostRemoto:portaRemota]. Prefisso -L facoltativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行1ルール：[ローカルポート:リモートホスト:リモートポート] または [バインドアドレス:ローカルポート:リモートホスト:リモートポート]。-L プレフィックスは省略可。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma regra por linha: [portaLocal:hostRemoto:portaRemota] ou [bind:portaLocal:hostRemoto:portaRemota]. Prefixo -L opcional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По одному правилу на строку: [localPort:remoteHost:remotePort] или [bindAddr:localPort:remoteHost:remotePort]. Префикс -L необязателен."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне правило на рядок: [локПорт:хостВіддалений:портВіддалений] або [bind:локПорт:хостВіддалений:портВіддалений]. Префікс -L необов'язковий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一条规则：[本地端口:远程主机:远程端口] 或 [绑定地址:本地端口:远程主机:远程端口]。可加 -L 前缀。"
          }
        }
      }
    },
