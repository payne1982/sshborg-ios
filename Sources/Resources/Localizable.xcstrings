    "ios_host_legacy_footer": {
      "comment": "iOS only — no Android counterpart. Translated for this app rather than imported, so unlike the rest it has not been through the Android app's review. Worth checking with a native speaker before release.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Veraltete Verfahren ermöglichen Verbindungen zu alten Servern, allerdings mit schwächerer Verschlüsselung. Nur aktivieren, wenn ein Server die Verbindung ablehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legacy ciphers let you reach old servers, at the cost of weaker cryptography. Leave off unless a server refuses to connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cifrados antiguos permiten conectarse a servidores obsoletos, a costa de una criptografía más débil. Déjalo desactivado salvo que un servidor rechace la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les algorithmes anciens permettent d'atteindre de vieux serveurs, au prix d'une cryptographie plus faible. À laisser désactivé sauf si un serveur refuse la connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I cifrari legacy permettono di raggiungere server vecchi, al costo di una crittografia più debole. Lascialo disattivato a meno che un server rifiuti la connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旧式の暗号方式は古いサーバーへの接続を可能にしますが、暗号強度は低下します。サーバーが接続を拒否する場合を除き、無効のままにしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As cifras antigas permitem alcançar servidores antigos, ao custo de criptografia mais fraca. Deixe desativado a menos que um servidor recuse a conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устаревшие шифры позволяют подключаться к старым серверам за счёт менее надёжной криптографии. Оставьте выключенным, если сервер не отказывает в подключении."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застарілі шифри дозволяють підключатися до старих серверів за рахунок слабшої криптографії. Залиште вимкненим, якщо сервер не відмовляє у підключенні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧式加密算法可连接老旧服务器，但加密强度较低。除非服务器拒绝连接，请保持关闭。"
          }
        }
      }
    },
    "ios_host_no_jump_candidates": {
      "comment": "iOS only — no Android counterpart. Translated for this app rather than imported, so unlike the rest it has not been through the Android app's review. Worth checking with a native speaker before release.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein anderer Host hat gespeicherte Zugangsdaten, um als Zwischenstation zu dienen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other host has a saved credential to use as a hop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún otro host tiene credenciales guardadas para usarse como salto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun autre hôte ne possède d'identifiants enregistrés pour servir de relais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun altro host ha credenziali salvate da usare come salto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中継として使用できる認証情報が保存されたホストがありません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum outro host tem credenciais salvas para usar como salto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни у одного другого хоста нет сохранённых учётных данных для использования в качестве промежуточного узла."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден інший хост не має збережених облікових даних для використання як проміжний вузол."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
