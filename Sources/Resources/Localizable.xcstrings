    "ios_keys_delete_impact": {
      "comment": "iOS only — no Android counterpart. Translated for this app rather than imported, so unlike the rest it has not been through the Android app's review. Worth checking with a native speaker before release.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wird von %2$d Hosts verwendet. Sie bleiben erhalten, wechseln aber zur Passwort-Anmeldung. Der private Schlüssel kann nicht wiederhergestellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is used by %2$d hosts. They will be kept but fall back to password authentication. The private key cannot be recovered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se usa en %2$d hosts. Se conservarán, pero pasarán a autenticación por contraseña. La clave privada no se puede recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est utilisée par %2$d hôtes. Ils seront conservés mais basculeront vers l'authentification par mot de passe. La clé privée est irrécupérable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è usata da %2$d host. Verranno conservati ma passeranno all'autenticazione con password. La chiave privata non è recuperabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は %2$d 台のホストで使用されています。ホストは保持されますが、パスワード認証に切り替わります。秘密鍵は復元できません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ é usada por %2$d hosts. Eles serão mantidos, mas passarão à autenticação por senha. A chave privada não pode ser recuperada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ используется %2$d хостами. Они сохранятся, но перейдут на вход по паролю. Закрытый ключ восстановить нельзя."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ використовується %2$d хостами. Вони збережуться, але перейдуть на вхід за паролем. Закритий ключ відновити неможливо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 正被 %2$d 台主机使用。这些主机会保留，但将改用密码认证。私钥无法恢复。"
          }
        }
      }
    },
