    "settings_suggestions_bar_sticky_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält die Vorschlagsleiste auf fester Höhe, um Größenänderungen des Terminals zu vermeiden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the suggestion bar at a fixed height to prevent the terminal from resizing when suggestions appear or disappear"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la barra de sugerencias a altura fija para evitar el redimensionamiento del terminal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintient la barre de suggestions à hauteur fixe pour éviter le redimensionnement du terminal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la barra dei suggerimenti a dimensione fissa per evitare il ridimensionamento del terminale quando i suggerimenti compaiono o scompaiono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補の表示・非表示でターミナルのサイズが変わらないよう、候補バーの高さを固定する"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a barra de sugestões em altura fixa para evitar o redimensionamento do terminal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держать панель подсказок фиксированной высоты, чтобы терминал не менялся в размере при их появлении или исчезновении"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає панель підказок фіксованої висоти, щоб уникнути зміни розміру терміналу"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持建议栏固定高度，防止建议出现或消失时终端调整大小"
          }
        }
      }
    },
