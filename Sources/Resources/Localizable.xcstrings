    "root_warning_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät scheint gerootet zu sein. Auf gerooteten Geräten sind die Sicherheitsgarantien des Android Keystores geschwächt, und andere Apps könnten auf sensible Daten zugreifen. Vorsicht geboten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device appears to be rooted. On rooted devices the security guarantees of the Android Keystore are weakened, and other apps may be able to access sensitive data. Proceed with caution."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo parece estar rooteado. En dispositivos rooteados, las garantías de seguridad del Android Keystore están debilitadas y otras aplicaciones podrían acceder a datos sensibles. Procede con precaución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil semble être rooté. Sur les appareils rootés, les garanties de sécurité de l'Android Keystore sont affaiblies et d'autres applications pourraient accéder aux données sensibles. Procédez avec prudence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo sembra essere con root. Sui dispositivi con root le garanzie di sicurezza dell'Android Keystore sono ridotte e altre app potrebbero accedere ai dati sensibili. Procedi con cautela."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは root 化されているようです。root 化されたデバイスでは Android Keystore のセキュリティ保証が弱まり、他のアプリが機密データにアクセスできる可能性があります。注意して使用してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo parece ter root. Em dispositivos com root, as garantias de segurança do Android Keystore estão enfraquecidas e outras aplicações podem aceder a dados sensíveis. Proceda com cautela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, на этом устройстве получены root-права. На устройствах с root гарантии безопасности Android Keystore ослаблены, и другие приложения могут получить доступ к конфиденциальным данным. Продолжайте с осторожностью."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схоже, цей пристрій має root-доступ. На пристроях з root гарантії безпеки Android Keystore послаблені, і інші додатки можуть отримати доступ до конфіденційних даних. Будьте обережні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备似乎已获取 root 权限。在 root 设备上，Android Keystore 的安全保障有所削弱，其他应用可能访问敏感数据。请谨慎使用。"
          }
        }
      }
    },
