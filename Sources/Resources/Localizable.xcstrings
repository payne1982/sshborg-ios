    "ios_keys_label_footer": {
      "comment": "iOS only — no Android counterpart. Translated for this app rather than imported, so unlike the rest it has not been through the Android app's review. Worth checking with a native speaker before release.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auch als Kommentar des Schlüssels gespeichert — das zeigt ein Server in seinen Protokollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also stored as the key's comment, which is what a server shows in its logs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se guarda como comentario de la clave, que es lo que un servidor muestra en sus registros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré aussi comme commentaire de la clé, ce qu'un serveur affiche dans ses journaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato anche come commento della chiave, che è ciò che un server mostra nei suoi log."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵のコメントとしても保存されます。サーバーのログに表示される値です。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Também salvo como comentário da chave, que é o que um servidor mostra nos seus registos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также сохраняется как комментарий ключа — именно он отображается в журналах сервера."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Також зберігається як коментар ключа — саме він відображається в журналах сервера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时保存为密钥的注释，服务器日志中显示的就是它。"
          }
        }
      }
    },
