    "ios_keys_comment_blank": {
      "comment": "iOS only — no Android counterpart. Translated for this app rather than imported, so unlike the rest it has not been through the Android app's review. Worth checking with a native speaker before release.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt das Feld leer, wird der Kommentar des Schlüssels verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left blank, the key's own comment is used."
