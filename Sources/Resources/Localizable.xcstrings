        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄の場合は鍵自体のコメントが使用されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se deixado em branco, usa-se o comentário da própria chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если оставить пустым, используется собственный комментарий ключа."
