    "host_reset_host_keys_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwirft den gespeicherten Hostschlüssel und zwischengespeicherte Jump-Host-Schlüssel. Bei der nächsten Verbindung wird der Server erneut überprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forgets the saved host key and cached jump-host keys. The next connection will verify the server again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvida la clave de host guardada y las claves de host de salto en caché. La próxima conexión verificará el servidor de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublie la clé d'hôte enregistrée et les clés de rebond en cache. La prochaine connexion vérifiera à nouveau le serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimentica la chiave host salvata e le chiavi jump-host in cache. Alla prossima connessione l'identità del server verrà verificata di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのホスト鍵とキャッシュされた踏み台ホスト鍵を破棄します。次回の接続時にサーバーを再検証します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquece a chave de host guardada e as chaves de host de salto em cache. A próxima ligação verifica novamente o servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забывает сохранённый ключ хоста и кешированные ключи промежуточных хостов. При следующем подключении сервер будет проверен заново."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забуває збережений ключ хоста та кешовані ключі проміжних хостів. Наступне зʼєднання знову перевірить сервер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忘记已保存的主机密钥和缓存的跳板主机密钥。下次连接时将重新验证服务器。"
          }
        }
      }
    },
