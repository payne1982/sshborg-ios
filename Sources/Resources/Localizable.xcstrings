    "keys_delete_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" löschen? Hosts, die diesen Schlüssel verwenden, fallen auf Passwort-Authentifizierung zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete \"%1$@\"? Any hosts using this key will fall back to password auth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar \"%1$@\"? Los hosts que usen esta clave usarán autenticación por contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer \"%1$@\" ? Les hôtes utilisant cette clé reviendront à l'authentification par mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare \"%1$@\"? Gli host che usano questa chiave torneranno all'autenticazione con password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" を削除しますか？この鍵を使用しているホストはパスワード認証に切り替わります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar \"%1$@\"? Os hosts que usam esta chave voltarão a usar autenticação por palavra-passe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить «%1$@»? Хосты, использующие этот ключ, перейдут на аутентификацию по паролю."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити \"%1$@\"? Хости, що використовують цей ключ, перейдуть на автентифікацію за паролем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除\"%1$@\"？使用此密钥的主机将改用密码验证。"
          }
        }
      }
    },
