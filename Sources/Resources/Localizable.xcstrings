    "ios_host_hidden_candidates": {
      "comment": "iOS only — no Android counterpart. Translated for this app rather than imported, so unlike the rest it has not been through the Android app's review. Worth checking with a native speaker before release.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d Hosts werden nicht aufgeführt, da sie kein gespeichertes Passwort oder Schlüssel haben — eine Zwischenstation kann nicht danach fragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d hosts are not listed because they have no saved password or key, which a hop cannot prompt for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d hosts no aparecen porque no tienen contraseña ni clave guardada, y un salto no puede solicitarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d hôtes ne sont pas listés car ils n'ont ni mot de passe ni clé enregistrés, qu'un relais ne peut pas demander."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d host non sono elencati perché non hanno password o chiave salvate, che un salto non può richiedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d 台のホストは、保存されたパスワードや鍵がないため表示されません。中継では入力を求められません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d hosts não são listados porque não têm senha ou chave salva, que um salto não pode solicitar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d хостов не показаны: у них нет сохранённого пароля или ключа, а промежуточный узел не может их запросить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d хостів не показано: у них немає збереженого пароля або ключа, а проміжний вузол не може їх запитати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d 台主机未列出，因为它们没有保存的密码或密钥，而跳板无法提示输入。"
          }
        }
      }
    },
