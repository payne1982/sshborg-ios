    "privacy_policy_dialog_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte lies unsere Datenschutzrichtlinie, bevor du SSHBorg verwendest. SSHBorg speichert alle Daten lokal auf deinem Gerät – es werden keine Daten an uns oder Dritte übermittelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before using SSHBorg, please review our Privacy Policy. SSHBorg stores all data locally on your device only — no data is ever sent to us or any third party."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de usar SSHBorg, revisa nuestra Política de privacidad. SSHBorg almacena todos los datos localmente en tu dispositivo — nunca se envía ningún dato a nosotros ni a terceros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant d'utiliser SSHBorg, veuillez lire notre Politique de confidentialité. SSHBorg stocke toutes les données localement sur votre appareil — aucune donnée n'est jamais envoyée à nous ou à des tiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di usare SSHBorg, leggi la nostra Informativa sulla privacy. SSHBorg conserva tutti i dati localmente sul tuo dispositivo — nessun dato viene mai inviato a noi o a terze parti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSHBorg をご利用になる前に、プライバシーポリシーをご確認ください。SSHBorg はすべてのデータをお使いのデバイスのみに保存します — データが私たちや第三者に送信されることは一切ありません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de usar o SSHBorg, revise a nossa Política de privacidade. O SSHBorg armazena todos os dados localmente no seu dispositivo — nenhum dado é enviado a nós ou a terceiros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед использованием SSHBorg ознакомьтесь с нашей Политикой конфиденциальности. SSHBorg хранит все данные только локально на вашем устройстве — они никогда не передаются нам или третьим лицам."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед використанням SSHBorg ознайомтеся з нашою Політикою конфіденційності. SSHBorg зберігає всі дані лише на вашому пристрої — жодні дані не передаються нам або третім особам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在使用 SSHBorg 之前，请阅读我们的隐私政策。SSHBorg 仅将所有数据存储在您的设备本地 — 任何数据均不会发送给我们或任何第三方。"
          }
        }
      }
    },
