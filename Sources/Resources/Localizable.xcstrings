    "settings_extra_keys_bar_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält die Zusatztastenleiste (Strg, Pfeile, F-Tasten…) auch bei geschlossener Tastatur sichtbar. Auch über die Pinnadel auf der Leiste umschaltbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the extra key bar (Ctrl, arrows, F-keys…) visible even when the keyboard is closed. You can also toggle this with the pin on the bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene visible la barra de teclas adicionales (Ctrl, flechas, teclas F…) incluso con el teclado cerrado. También puedes cambiarlo con el pin de la barra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde la barre de touches supplémentaires (Ctrl, flèches, touches F…) visible même clavier fermé. Réglable aussi avec l'épingle sur la barre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene visibile la barra dei tasti extra (Ctrl, frecce, tasti F…) anche a tastiera chiusa. Puoi cambiarlo anche con il pin sulla barra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードを閉じていても追加キーバー（Ctrl、矢印、Fキーなど）を表示したままにします。バー上のピンでも切り替えられます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a barra de teclas extra (Ctrl, setas, teclas F…) visível mesmo com o teclado fechado. Também pode alterná-la com o pin na barra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держать панель дополнительных клавиш (Ctrl, стрелки, F-клавиши…) видимой даже при закрытой клавиатуре. Переключается также булавкой на панели."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримає панель додаткових клавіш (Ctrl, стрілки, клавіші F…) видимою навіть із закритою клавіатурою. Це також можна перемкнути шпилькою на панелі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使键盘关闭，也保持额外按键栏（Ctrl、方向键、F 键…）可见。也可通过按键栏上的图钉切换。"
          }
        }
      }
    },
